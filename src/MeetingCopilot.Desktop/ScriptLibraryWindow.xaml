<Window x:Class="MeetingCopilot.Desktop.ScriptLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MeetingCopilot.Desktop"
        Title="Presentation scripts" Style="{StaticResource CopilotWindowStyle}"
        Width="980" Height="780" MinWidth="680" MinHeight="640" WindowStartupLocation="CenterScreen">
    <DockPanel Margin="28,22,28,24">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
            <Button x:Name="BackButton" Content="Back" Click="Back_Click" Style="{StaticResource QuietButton}" HorizontalAlignment="Left" local:ButtonIcon.Data="{StaticResource BackIcon}"/>
            <TextBlock Text="Your presentation, at your pace." FontSize="26" FontWeight="SemiBold"/>
            <TextBlock Text="Save a script and open the reader. Choose voice following with Azure Speech, or timed scrolling offline." Style="{StaticResource Hint}" Margin="0,6,0,8"/>
            <TextBlock x:Name="CaptureStatus" Foreground="{DynamicResource Secondary}" FontSize="12" AutomationProperties.LiveSetting="Polite"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <TextBlock x:Name="LibraryError" Foreground="{DynamicResource Danger}" Style="{StaticResource NonemptyStatus}"
                       AutomationProperties.LiveSetting="Polite" Margin="0,0,0,8"/>
            <TextBlock x:Name="LibraryStatus" Text="Create your first script." Style="{StaticResource Hint}"
                       AutomationProperties.LiveSetting="Polite"/>
            <WrapPanel>
                <Button x:Name="OpenReaderButton" Content="Save and open reader" Style="{StaticResource PrimaryButton}" Click="OpenReader_Click" local:ButtonIcon.Data="{StaticResource ScriptIcon}"/>
                <Button x:Name="OpenMinimalButton" Content="Open minimal overlay" Click="OpenMinimal_Click" local:ButtonIcon.Data="{StaticResource OverlayIcon}"/>
                <Button x:Name="ToggleMinimalButton" Content="Hide overlay" Click="ToggleMinimal_Click" Visibility="Collapsed"/>
            </WrapPanel>
            <TextBlock Text="Minimal overlay stays offline. Capture exclusion is required, but verify it in your sharing app."
                       Style="{StaticResource Hint}" FontSize="12" Margin="0,0,0,4"/>
            <Expander Header="Minimal overlay controls">
                <TextBlock Text="Run scrolls; Stop keeps your position. Scroll manually at any time. Drag the top edge to move and the bottom corner to resize. Home resets. The top-left arrow hides the overlay and returns here; Show overlay restores your position, stopped. X or Alt+F4 closes the reader and returns here. Uses the full reader's saved speed and text size."
                           Style="{StaticResource Hint}" FontSize="12"/>
            </Expander>
            <TextBlock Text="Scripts and reading settings are saved locally with Windows account encryption. Unlike meeting context, saved scripts remain after Stop or restart. Position is not saved."
                       Style="{StaticResource Hint}" Margin="0,6,0,0" FontSize="12"/>
        </StackPanel>
        <Grid x:Name="LibraryWorkspace">
            <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Script library" FontWeight="SemiBold" FontSize="17" Margin="0,0,0,12"/>
                    <WrapPanel>
                        <Button x:Name="NewScriptButton" Content="New script" Click="New_Click"/>
                        <Button x:Name="ReloadScriptsButton" Content="Reload" Style="{StaticResource QuietButton}" Click="Reload_Click"/>
                    </WrapPanel>
                    <TextBlock x:Name="LibraryEmpty" Text="No saved scripts yet. Give your presentation a title and paste your text."
                               Style="{StaticResource Hint}"/>
                </StackPanel>
                <ListBox x:Name="ScriptsList" BorderThickness="0" Background="{DynamicResource Raised}" Foreground="{DynamicResource Foreground}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="Script_Selected"
                         AutomationProperties.Name="Saved presentation scripts">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
            <DockPanel Grid.Column="2">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Presentation title" FontWeight="SemiBold"/>
                    <TextBox x:Name="ScriptTitleBox" MaxLength="120" TextChanged="Draft_Changed" AutomationProperties.Name="Presentation title"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Presentation text" FontWeight="SemiBold"/>
                        <TextBlock x:Name="CharacterCount" Grid.Column="1" FontSize="12" Foreground="{DynamicResource Secondary}" Margin="8,0,0,0"/>
                    </Grid>
                    <TextBlock Text="Separate paragraphs with a blank line to use paragraph navigation." Style="{StaticResource Hint}" FontSize="12"/>
                </StackPanel>
                <WrapPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <Button x:Name="SaveScriptButton" Content="Save script" Click="Save_Click" local:ButtonIcon.Data="{StaticResource SaveIcon}"/>
                    <Button x:Name="DeleteScriptButton" Content="Delete script" Click="Delete_Click" Style="{StaticResource DangerButton}" IsEnabled="False"/>
                </WrapPanel>
                <TextBox x:Name="ScriptBodyBox" AcceptsReturn="True" MaxLength="100000" TextWrapping="Wrap"
                         VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                         TextChanged="Draft_Changed" Margin="0" AutomationProperties.Name="Presentation script text"/>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
