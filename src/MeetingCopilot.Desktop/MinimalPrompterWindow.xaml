<Window x:Class="MeetingCopilot.Desktop.MinimalPrompterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MeetingCopilot.Desktop"
        Title="Minimal offline teleprompter" Style="{StaticResource CopilotWindowStyle}"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ResizeMode="NoResize" Width="720" Height="360" MinWidth="360" MinHeight="220"
        WindowStartupLocation="Manual" PreviewKeyDown="Overlay_KeyDown">
    <Border x:Name="ProtectedContent" Visibility="Hidden" CornerRadius="6"
            Background="{DynamicResource PrompterSurface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="58"/>
            </Grid.RowDefinitions>
            <Grid Background="Transparent" Margin="36,0,36,0" Cursor="SizeAll" MouseLeftButtonDown="Move_MouseDown"
                  AutomationProperties.Name="Drag to move the prompter">
                <Border Width="36" Height="2" CornerRadius="1" Background="{DynamicResource Secondary}" Opacity="0.65"/>
            </Grid>
            <Button x:Name="LibraryButton" HorizontalAlignment="Left" Width="30" Height="28" MinHeight="28"
                    Margin="2,0,0,0" Padding="8" Click="Library_Click" Style="{StaticResource QuietButton}"
                    AutomationProperties.Name="Hide overlay and return to scripts" ToolTip="Hide overlay and return to scripts">
                <Path Data="M 6 0 L 1 5 L 6 10 M 1 5 L 11 5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.5" Width="11" Height="10" IsHitTestVisible="False"/>
            </Button>
            <Button x:Name="CloseButton" HorizontalAlignment="Right" Width="30" Height="28" MinHeight="28"
                    Margin="0,0,2,0" Padding="8" Click="Close_Click" Style="{StaticResource QuietButton}"
                    AutomationProperties.Name="Close prompter" ToolTip="Close prompter (Alt+F4)">
                <Path Data="M 0 0 L 10 10 M 10 0 L 0 10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.5" Width="10" Height="10" IsHitTestVisible="False"/>
            </Button>
            <ScrollViewer x:Name="ScriptScroll" Grid.Row="1" Margin="24,0,12,0" Focusable="True"
                          CanContentScroll="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          PreviewMouseWheel="Scroll_MouseWheel" PreviewMouseLeftButtonDown="Scroll_MouseDown"
                          ScrollChanged="Script_ScrollChanged" SizeChanged="Script_SizeChanged"
                          AutomationProperties.Name="Offline presentation text"
                          AutomationProperties.HelpText="Scroll manually to pause. Run resumes. Escape stops. Home returns to the start. Alt+F4 closes.">
                <StackPanel Margin="0,0,12,0">
                    <TextBlock x:Name="ScriptText" Foreground="{DynamicResource Foreground}" TextWrapping="Wrap"
                               LineStackingStrategy="BlockLineHeight"/>
                    <Border x:Name="EndSpace"/>
                </StackPanel>
            </ScrollViewer>
            <Grid Grid.Row="2" Margin="24,10,24,10" Background="Transparent" MouseLeftButtonDown="Move_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="RunButton" Content="Run" Click="Run_Click" Style="{StaticResource PrimaryButton}" local:ButtonIcon.Data="{StaticResource PlayIcon}"
                        MinWidth="76" Margin="0,0,8,0"/>
                <Button x:Name="StopButton" Grid.Column="1" Content="Stop" Click="Stop_Click" local:ButtonIcon.Data="{StaticResource StopIcon}"
                        MinWidth="76" Margin="0" IsEnabled="False"/>
                <TextBlock x:Name="PlaybackStatus" Grid.Column="2" Text="Stopped" FontSize="12"
                           Foreground="{DynamicResource Foreground}" Margin="12,0,0,0" VerticalAlignment="Center"
                           AutomationProperties.LiveSetting="Polite"/>
            </Grid>
            <Thumb x:Name="ResizeHandle" Grid.Row="2" Width="20" Height="20" HorizontalAlignment="Right"
                   VerticalAlignment="Bottom" Cursor="SizeNWSE" DragDelta="Resize_DragDelta"
                   AutomationProperties.Name="Resize prompter">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                            <Path Data="M 7 16 L 16 7 M 12 16 L 16 12" Stroke="{DynamicResource Secondary}" StrokeThickness="1"/>
                        </Grid>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>
    </Border>
</Window>
